<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0" style="color: var(--ink);">
      <i class="fa-solid fa-heart me-2" style="color: var(--primary);"></i>Saved PGs
    </h2>
    <a href="/listings" class="btn btn-outline-light rounded-3" 
       style="border-color: var(--border); color: var(--ink-soft);">
      Explore more
    </a>
  </div>

  <% if (!savedListings.length) { %>
    <div class="empty-state">
      <i class="fa-solid fa-bookmark"></i>
      <h4>No saved PGs yet</h4>
      <p>Save listings you like and compare them later.</p>
      <a href="/listings" class="btn auth-btn mt-2 px-4">
        Explore Listings
      </a>
    </div>

  <% } else { %>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">
      <% for (let listing of savedListings) { %>
        <% if (listing) { %>
          <div class="col">
            <div class="booking-card-item h-100 d-flex flex-column">

              <a href="/listings/<%= listing._id %>" class="listing-link">
                <img
                  src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?auto=format&fit=crop&w=800&q=80' %>"
                  class="booking-img"
                  alt="<%= listing.title %>"
                />
                <div class="p-3 flex-grow-1">
                  <b class="listing-title"><%= listing.title %></b>
                  <p class="mt-1 mb-1" style="font-size:0.82rem; color: var(--ink-soft);">
                    <i class="fa-solid fa-location-dot me-1" style="color: var(--primary);"></i>
                    <%= listing.location %>
                  </p>
                  <span class="listing-price">
                    ₹<%= listing.price.toLocaleString("en-IN") %>
                    <span class="unit">/month</span>
                  </span>
                </div>
              </a>

              <div class="px-3 pb-3">
                <form action="/listings/<%= listing._id %>/wishlist" method="POST">
                  <button class="btn cancel-btn w-100">
                    <i class="fa-solid fa-heart-crack me-2"></i>Remove
                  </button>
                </form>
              </div>

            </div>
          </div>
        <% } %>
      <% } %>
    </div>
  <% } %>
</div>