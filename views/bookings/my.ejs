<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5">
  <h2 class="mb-4 text-white">
    <i class="fa-solid fa-calendar-days" style="color: var(--primary);"></i>
    My Bookings
  </h2>

  <% if (bookings.length === 0) { %>
    <div class="empty-state">
      <i class="fa-solid fa-suitcase-rolling"></i>
      <h4>No bookings yet!</h4>
      <p>Explore listings and find your perfect PG.</p>
      <a href="/listings" class="btn auth-btn mt-2 px-4">
        Explore Listings
      </a>
    </div>

  <% } else { %>
    <div class="row g-4">
      <% for (let booking of bookings) { %>
        <% if (booking.listing) { %>
          <div class="col-md-6 col-lg-4">
            <div class="booking-card-item">

              <a href="/listings/<%= booking.listing._id %>">
                <img
                  src="<%= booking.listing.image && booking.listing.image.url ? booking.listing.image.url : 'https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?auto=format&fit=crop&w=800&q=80' %>"
                  alt="<%= booking.listing.title %>"
                  class="booking-img"
                />
              </a>

              <div class="p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h5 class="mb-0" style="font-size:0.95rem; color: var(--ink);">
                    <a href="/listings/<%= booking.listing._id %>" class="text-decoration-none" style="color: var(--ink);">
                      <%= booking.listing.title %>
                    </a>
                  </h5>
                  <span class="<%= booking.status === 'confirmed' ? 'badge-confirmed' : booking.status === 'pending' ? 'badge-pending' : booking.status === 'cancelled' ? 'badge-cancelled' : 'badge-rejected' %>">
                    <%= booking.status || "pending" %>
                  </span>
                </div>

                <p class="mb-2" style="font-size:0.82rem; color: var(--ink-soft);">
                  <i class="fa-solid fa-location-dot me-1" style="color: var(--primary);"></i>
                  <%= booking.listing.location %>, <%= booking.listing.country %>
                </p>

                <div class="d-flex gap-3 mb-2" style="font-size:0.88rem;">
                  <div>
                    <div style="font-size:0.7rem; color: var(--ink-muted); font-weight:700; text-transform:uppercase; letter-spacing:0.4px;">Check-in</div>
                    <b style="color: var(--ink);">
                      <%= new Date(booking.checkIn).toLocaleDateString("en-IN", { day:"numeric", month:"short", year:"numeric" }) %>
                    </b>
                  </div>
                  <div class="d-flex align-items-center">
                    <i class="fa-solid fa-arrow-right" style="color: var(--ink-muted);"></i>
                  </div>
                  <div>
                    <div style="font-size:0.7rem; color: var(--ink-muted); font-weight:700; text-transform:uppercase; letter-spacing:0.4px;">Check-out</div>
                    <b style="color: var(--ink);">
                      <%= new Date(booking.checkOut).toLocaleDateString("en-IN", { day:"numeric", month:"short", year:"numeric" }) %>
                    </b>
                  </div>
                </div>

                <div class="mb-3" style="font-size:0.95rem;">
                  <i class="fa-solid fa-indian-rupee-sign" style="color: var(--primary);"></i>
                  <b style="color: var(--ink);">₹<%= booking.totalPrice.toLocaleString("en-IN") %></b>
                  <span style="color: var(--ink-muted);">total</span>
                </div>

                <% const today = new Date(); today.setHours(0,0,0,0); %>
                <% const checkInDate = new Date(booking.checkIn); %>
                <% if (checkInDate > today && booking.status !== "cancelled" && booking.status !== "rejected") { %>
                  <form action="/bookings/<%= booking._id %>?_method=DELETE" method="POST"
                        onsubmit="return confirm('Cancel this booking?')">
                    <button class="btn cancel-btn w-100">
                      <i class="fa-solid fa-xmark me-1"></i> Cancel Booking
                    </button>
                  </form>
                <% } else { %>
                  <div class="text-center" style="font-size:0.8rem; color: var(--ink-muted);">
                    <i class="fa-solid fa-clock me-1"></i> No cancellation available
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        <% } %>
      <% } %>
    </div>
  <% } %>
</div>