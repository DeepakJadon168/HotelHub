<% layout("/layouts/boilerplate") %>

<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-header">
      <i class="fa-solid fa-right-to-bracket auth-icon"></i>
      <h2>Welcome back</h2>
      <p>Login to your PG Wallah account</p>
    </div>

    <form action="/login" method="POST" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input type="text" id="username" class="form-control" name="username" placeholder="Enter username" required>
        <div class="invalid-feedback">Username required</div>
      </div>

      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input type="password" id="password" class="form-control" name="password" placeholder="Enter password" required>
        <div class="invalid-feedback">Password required</div>
      </div>

      <button class="btn auth-btn w-100 mt-2">
        <i class="fa-solid fa-right-to-bracket me-2"></i> Log In
      </button>

      <p class="auth-footer-text">
        Don't have an account? <a href="/signup">Sign up</a>
      </p>
    </form>
  </div>
</div>